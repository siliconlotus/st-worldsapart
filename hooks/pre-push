#!/bin/sh
# pre-push — release must carry a plain X.Y.Z with a tag of that name on the tip; staging must carry the
# +build.N counter. Every other branch pushes untouched. git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
ZERO=0000000000000000000000000000000000000000
ROOT=$(git rev-parse --show-toplevel)
status=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue   # deleting a branch is not a push

    case "$remote_ref" in
        refs/heads/release|refs/heads/staging) ;;
        *) continue ;;
    esac

    # Out of the commit being pushed, not the worktree: pushing release from another branch is the normal case.
    version=$(git show "$local_sha:manifest.json" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    if [ -z "$version" ]; then
        echo "pre-push: no version in manifest.json" >&2
        status=1
        continue
    fi

    if [ "$remote_ref" = "refs/heads/staging" ]; then
        if ! WA_VERSION="$version" node -e "import('$ROOT/eval/version.mjs').then(m => process.exit(m.hasBuildCounter(process.env.WA_VERSION) ? 0 : 1))"; then
            echo "pre-push: staging carries the build counter; manifest.json says $version, not X.Y.Z+build.N" >&2
            status=1
        fi
        continue
    fi

    if ! WA_VERSION="$version" node -e "import('$ROOT/eval/version.mjs').then(m => process.exit(m.isReleaseVersion(process.env.WA_VERSION) ? 0 : 1))"; then
        echo "pre-push: release carries a plain X.Y.Z; manifest.json says $version" >&2
        status=1
        continue
    fi

    # rev-list resolves an annotated tag to the commit it points at, so both tag kinds compare alike.
    tagged=$(git rev-list -n 1 "$version" 2>/dev/null)
    if [ -z "$tagged" ]; then
        echo "pre-push: manifest.json says $version, but there is no tag $version." >&2
        echo "          git tag -a $version -m $version && git push origin $version" >&2
        status=1
    elif [ "$tagged" != "$local_sha" ]; then
        echo "pre-push: tag $version is on $(git rev-parse --short "$tagged"), not on the commit being pushed" >&2
        echo "          ($(git rev-parse --short "$local_sha")). Move the tag, or bump the version." >&2
        status=1
    fi
done

exit $status
