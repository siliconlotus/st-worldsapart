#!/bin/sh
# pre-push — on `main` ONLY: refuse a push whose tip carries no tag matching manifest.json's version.
#
# A bundle records `<branch>@<git describe>`, so a version becomes a fact about a commit only when a tag
# says so; a declared version with no tag behind it silently produces captures labelled by sha. main is
# the one branch where that matters, because a release is one squashed commit and its identity is meant
# to be exactly a version (bundle-schema.md, "The version fields").
#
# Every other branch pushes untouched — a feature branch labelling its captures by commit is correct.
#
# git feeds pre-push one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
ZERO=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ "$remote_ref" = "refs/heads/main" ] || continue
    [ "$local_sha" = "$ZERO" ] && continue   # deleting the branch is not a release

    version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' manifest.json | head -1)
    if [ -z "$version" ]; then
        echo "pre-push: no version in manifest.json" >&2
        status=1
        continue
    fi

    # rev-list resolves an annotated tag to the commit it points at, so both tag kinds compare alike.
    tagged=$(git rev-list -n 1 "$version" 2>/dev/null)
    if [ -z "$tagged" ]; then
        echo "pre-push: manifest.json says $version, but there is no tag $version." >&2
        echo "          git tag -a $version -m $version && git push origin $version" >&2
        status=1
    elif [ "$tagged" != "$local_sha" ]; then
        echo "pre-push: tag $version is on $(git rev-parse --short "$tagged"), not on the commit being pushed" >&2
        echo "          ($(git rev-parse --short "$local_sha")). Move the tag, or bump the version." >&2
        status=1
    fi
done

exit $status
